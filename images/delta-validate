#!/usr/bin/env python3
"""Ask the Delta host to run the hidden tests against /workspace."""

import json
import os
import sys
import time
import uuid

IPC = os.environ.get("DELTA_IPC", "/delta-ipc")
TIMEOUT_S = 900

request_id = uuid.uuid4().hex
request_path = os.path.join(IPC, "requests", f"{request_id}.json")
response_path = os.path.join(IPC, "responses", f"{request_id}.json")

with open(request_path + ".tmp", "w") as f:
    json.dump({"id": request_id, "at": time.time()}, f)
os.replace(request_path + ".tmp", request_path)

print("Running tests...", flush=True)
deadline = time.time() + TIMEOUT_S
while not os.path.exists(response_path):
    if time.time() > deadline:
        print("Validation timed out.")
        sys.exit(2)
    time.sleep(0.5)

with open(response_path) as f:
    result = json.load(f)

print(result["message"])
sys.exit(0 if result["strict"] else 1)
